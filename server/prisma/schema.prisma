// ============================================================================
// SKEMA DATABASE AEGISVAULT (SQLITE)
// ============================================================================
// Catatan untuk Presentasi Dosen:
// Kolom-kolom bertanda `Encrypted` disimpan di dalam tabel SQLite menggunakan
// enkripsi level database AES-256-GCM (`DBENC$v1$<iv>$<tag>$<ciphertext>`).

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      Int      @id @default(autoincrement())
  username                String   @unique
  fullNameEncrypted       String   // Dienkripsi AES-256-GCM di DB
  role                    String   @default("INVESTIGATOR")
  passwordHash            String   // Scrypt + Salt 16-byte
  dongleIdEncrypted       String   // Dienkripsi AES-256-GCM di DB
  faceDescriptorEncrypted String   // Vektor 128-float Wajah (Dienkripsi AES-256-GCM di DB)
  secretNoteEncrypted     String   // Catatan kredensial sensitif (Dienkripsi AES-256-GCM di DB)
  createdAt               String
}

model SecretMessage {
  id                      Int      @id @default(autoincrement())
  title                   String
  senderEncrypted         String   // Identitas pengirim (Dienkripsi AES-256-GCM di DB)
  mode                    String   // CBC atau ECB
  stage1VigenerePreview   String
  stage2VernamHex         String
  superCiphertextPayload  String   // Hasil Super Enkripsi (Vigenere + Vernam + AES-256)
  createdAt               String
}

model EncryptedFile {
  id                      Int      @id @default(autoincrement())
  originalName            String
  mimeType                String
  sizeBytes               Int
  storedFileName          String   // File .enc di folder /uploads (ChaCha20-Poly1305)
  nonceHex                String
  authTagHex              String
  originalSha256          String
  uploaderEncrypted       String   // Dienkripsi AES-256-GCM di DB
  createdAt               String
}

model StegoImage {
  id                      Int      @id @default(autoincrement())
  title                   String
  storedPngName           String   // File PNG Lossless ber-payload LSB di /uploads
  width                   Int
  height                  Int
  embeddedBitsCount       Int
  psnrDb                  Float
  mse                     Float
  uploaderEncrypted       String   // Dienkripsi AES-256-GCM di DB
  createdAt               String
}

model BlockchainLedger {
  index                   Int      @id
  timestamp               String
  actionType              String
  actor                   String
  assetTitle              String
  assetDataHash           String
  previousHash            String
  nonce                   Int
  hash                    String
}
